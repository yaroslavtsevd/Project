{
  "name": "lr5-polls-api-ts",
  "version": "1.0.0",
  "description": "TS REST API – Lab 5 (Vulnerabilities & Security)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-public.js",
    "start": "node dist/src/index.js",
    "seed": "tsx src/db/seed.ts",
    "reset-db": "node scripts/reset-db.js",
    "fresh": "node scripts/reset-db.js && tsx src/db/seed.ts",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.18.3",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/sqlite3": "^3.1.11",
    "eslint": "^9.39.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.3"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.0": true,
    "sqlite3@6.0.1": true
  }
}
